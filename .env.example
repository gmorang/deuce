# Config do Firebase (Project settings > General > Your apps > SDK setup).
# Estes valores NÃO são secretos — o que protege os dados são as Firestore
# security rules. Copie para `.env.local` e preencha com o seu projeto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Desenvolvimento local: use os emuladores (auth + Firestore fake) em vez da
# nuvem. Deixe vazio/ausente para usar o Firebase real. Só tem efeito em `pnpm
# dev` — o build de produção ignora isto. Requer `pnpm emulators` rodando.
VITE_USE_AUTH_EMULATOR=
