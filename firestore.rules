rules_version = '2';

// Private, invite-only rankings for a trusted group of friends.
//
// - users/{uid}: canonical profile, self-writable except `role`.
// - inviteCodes/{code}: public lookup (code -> rankingId) so a joiner can find a
//   private ranking. Readable by any signed-in user (you must know the code);
//   only admins create/revoke them.
// - rankings/{id} and all subcollections are readable only by MEMBERS (or admin).
//   You join by creating your own member doc with a valid invite code.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isMember(rankingId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rankings/$(rankingId)/members/$(request.auth.uid));
    }

    // A join is valid when the supplied code maps to this ranking.
    function validInvite(rankingId, code) {
      return code is string
        && exists(/databases/$(database)/documents/inviteCodes/$(code))
        && get(/databases/$(database)/documents/inviteCodes/$(code)).data.rankingId == rankingId;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'player';
      allow update: if signedIn() && (
        isAdmin()
        || (request.auth.uid == uid && request.resource.data.role == resource.data.role)
      );
      allow delete: if false;
    }

    // Code -> rankingId lookup. Knowing the code is the gate to read it.
    match /inviteCodes/{code} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /rankings/{rankingId} {
      allow read: if isMember(rankingId) || isAdmin();
      allow create: if isAdmin() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();

      match /members/{uid} {
        // Members (and admins) see the roster; you can always read your own doc,
        // and reads of a missing doc are allowed so a joiner can check membership.
        allow read: if signedIn() && (isAdmin() || isMember(rankingId) || resource == null || resource.data.uid == request.auth.uid);

        // Join: your own uid, clean stats, and either you're admin or you have a
        // valid invite code for this ranking.
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.wins == 0
          && request.resource.data.losses == 0
          && request.resource.data.matchesPlayed == 0
          && (isAdmin() || validInvite(rankingId, request.resource.data.viaCode));

        // Trust-based rating updates when recording a match (members only).
        allow update: if isMember(rankingId) || isAdmin();
        allow delete: if isAdmin() || request.auth.uid == uid;
      }

      match /matches/{matchId} {
        allow read: if isMember(rankingId) || isAdmin();
        allow create: if isMember(rankingId) || isAdmin();
        allow update: if false; // append-only
        allow delete: if isAdmin();
      }

      // Weekly draw. Admin opens/draws/closes; members confirm themselves.
      match /rounds/{roundId} {
        allow read: if isMember(rankingId) || isAdmin();
        allow create, update, delete: if isAdmin();

        match /participants/{uid} {
          allow read: if isMember(rankingId) || isAdmin();
          allow create, delete: if signedIn() && request.auth.uid == uid && isMember(rankingId);
          allow update: if false;
        }

        match /fixtures/{fixtureId} {
          allow read: if isMember(rankingId) || isAdmin();
          allow create, delete: if isAdmin();
          allow update: if isMember(rankingId) || isAdmin();
        }
      }
    }
  }
}
